# =============================================================================
# Coolify — переменные окружения Master of Sword
# =============================================================================
# Скопируй нужные блоки в Environment Variables сервиса Coolify.
# Секреты сюда не коммить — заполняй только в панели Coolify.
#
# Важно:
# - NEXT_PUBLIC_* задаются как Build-time (и Runtime) — после смены нужен rebuild.
# - S3_* — Runtime (взяты из L:\GFF\GFF Selectel-шаблона). В MoS код S3 пока
#   не читает эти переменные; задай их заранее под медиа/аплоады.
# =============================================================================


# -----------------------------------------------------------------------------
# 1) WEB (сервис Next.js / apps/web) — ОБЯЗАТЕЛЬНО для работы сайта с логином
# -----------------------------------------------------------------------------

# Публичный URL school-api (логин, кабинет, админка)
NEXT_PUBLIC_SCHOOL_API=https://school-api.YOUR-DOMAIN.tld

# Публичный URL auth-adapter (кнопка OnlyID; сейчас sandbox)
NEXT_PUBLIC_AUTH_URL=https://auth.YOUR-DOMAIN.tld

# Зарезервировано (в web пока не используется, можно задать сразу)
NEXT_PUBLIC_PLATFORM_API=https://platform-api.YOUR-DOMAIN.tld

# Публичный URL support-chat (виджет + Telegram webhook)
NEXT_PUBLIC_SUPPORT_CHAT_API=https://chat-api.YOUR-DOMAIN.tld
NEXT_PUBLIC_SUPPORT_CHAT_WS=wss://chat-api.YOUR-DOMAIN.tld

# Публичный URL самого сайта (удобно для ссылок/OG; пока не обязателен коду)
NEXT_PUBLIC_SITE_URL=https://YOUR-DOMAIN.tld

# Hero-видео/постеры с S3 (после scripts/upload-hero-media-to-s3.mjs).
# Без trailing slash. Локальный fallback в коде: /media/hero
# NEXT_PUBLIC_MEDIA_BASE_URL=https://your-bucket.selstorage.ru/your-bucket/media/hero

# Quest/achievement PNG icons (after scripts/upload-content-icons-to-s3.mjs).
# Local fallback in code: /media/content-icons
# NEXT_PUBLIC_CONTENT_ICONS_BASE_URL=https://your-bucket.selstorage.ru/your-bucket/media/content-icons


# -----------------------------------------------------------------------------
# 2) SCHOOL-API (отдельный сервис Go) — нужен для логина/admin
# -----------------------------------------------------------------------------

# Слушать все интерфейсы внутри контейнера (НЕ 127.0.0.1)
SCHOOL_API_ADDR=0.0.0.0:8082

# Если Coolify прокидывает PORT — можно:
# SCHOOL_API_ADDR=0.0.0.0:${PORT}


# -----------------------------------------------------------------------------
# 2b) SUPPORT-CHAT (отдельный сервис Go) — виджет + Telegram webhook
# -----------------------------------------------------------------------------

OGC_TELEGRAM__PUBLIC_BASE_URL=https://chat-api.YOUR-DOMAIN.tld
OGC_TELEGRAM_BOT_TOKEN=
OGC_TELEGRAM_SUPPORT_CHAT_ID=-1000000000000
OGC_TELEGRAM_WEBHOOK_SECRET=

OGC_POSTGRESQL__USERNAME=
OGC_POSTGRESQL__PASSWORD=
OGC_POSTGRESQL__DB_HOST=
OGC_POSTGRESQL__DB_PORT=5432
OGC_POSTGRESQL__DBNAME=mos_chat

OGC_STORAGE__ACCESS_KEY=
OGC_STORAGE__SECRET_KEY=
OGC_STORAGE__BUCKET=mos-chat
OGC_STORAGE__ENDPOINT=https://s3.ru-7.storage.selcloud.ru
OGC_STORAGE__REGION=ru-7


# -----------------------------------------------------------------------------
# 3) AUTH-ADAPTER (отдельный сервис Go) — только если нужна кнопка OnlyID
# -----------------------------------------------------------------------------

AUTH_ADDR=0.0.0.0:8083


# -----------------------------------------------------------------------------
# 4) PLATFORM-API (опционально сейчас; web его не вызывает)
# -----------------------------------------------------------------------------

PLATFORM_API_ADDR=0.0.0.0:8081


# -----------------------------------------------------------------------------
# 5) S3 (Selectel) — настройки из репозитория GFF (L:\GFF\GFF)
#    Источник: .env.example / .env.s3.example
#    Runtime-переменные того же сервиса, где будет upload (web или API)
# -----------------------------------------------------------------------------

S3_ENDPOINT=https://s3.ru-7.storage.selcloud.ru
S3_REGION=ru-7
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET=your-bucket-name

# Публичный URL бакета/CDN (если бакет публичный).
# Если не задан — в GFF файлы раздаются через /api/s3/[key].
# S3_PUBLIC_BASE_URL=https://your-bucket.selstorage.ru


# -----------------------------------------------------------------------------
# 6) Инфра на будущее (в текущем vertical slice API их ещё не читает)
# -----------------------------------------------------------------------------

# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/mos?sslmode=require
# REDIS_URL=redis://:PASSWORD@HOST:6379
