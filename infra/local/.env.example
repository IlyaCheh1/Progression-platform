PLATFORM_API_ADDR=:8081
SCHOOL_API_ADDR=127.0.0.1:8082
AUTH_ADDR=:8083
DATABASE_URL=postgres://mos:mos@localhost:5432/mos?sslmode=disable
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# S3 — локальный MinIO (docker-compose) ИЛИ Selectel
# Скопируй файл:  cp infra/local/.env.example infra/local/.env
# и заполни нужный блок. Секреты в Git не коммить.
# -----------------------------------------------------------------------------

# --- Вариант A: Local MinIO (infra/local/docker-compose) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=ru-7
S3_ACCESS_KEY=mosminio
S3_SECRET_KEY=mosminio123
S3_BUCKET=mos
# S3_PUBLIC_BASE_URL=

# --- Вариант B: Selectel (заполни и раскомментируй; закомментируй блок A) ---
# S3_ENDPOINT=https://s3.ru-7.storage.selcloud.ru
# S3_REGION=ru-7
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
# S3_PUBLIC_BASE_URL=https://<bucket-uuid>.selstorage.ru
# S3_PRESIGNED_TTL=300

# Выгрузка фонов профиля / media на S3:
#   node --env-file=infra/local/.env scripts/upload-backgrounds-to-s3.mjs
#   node --env-file=infra/local/.env scripts/upload-all-media-to-s3.mjs

# Hero videos (after upload-hero-media-to-s3.mjs). Selectel: no /bucket/ after domain.
# NEXT_PUBLIC_MEDIA_BASE_URL=/media/hero
# или https://<bucket-uuid>.selstorage.ru/media/hero  (UUID из панели, НЕ имя бакета)

# PNG icons for quests/achievements (after upload-content-icons-to-s3.mjs)
# Quest/achievement/talent WebP icons (after scripts/upload-content-icons-to-s3.mjs)
# NEXT_PUBLIC_CONTENT_ICONS_BASE_URL=https://<bucket-uuid>.selstorage.ru/media/content-icons

NEXT_PUBLIC_SCHOOL_API=http://localhost:8082
NEXT_PUBLIC_PLATFORM_API=http://localhost:8081
NEXT_PUBLIC_AUTH_URL=http://localhost:8083
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_CHAT_API=http://127.0.0.1:8084
NEXT_PUBLIC_SUPPORT_CHAT_WS=ws://127.0.0.1:8084

# OnlyID (локально: секреты только в infra/local/.env, не в git)
SSO_BASE_URL=https://onlyid.ru
SSO_ISSUER=https://api.onlyid.ru/api/v1/user
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/oauth/callback
AUTH_SECRET=dev-change-me-auth-secret
SSO_BRIDGE_SECRET=dev-change-me-bridge-secret
SCHOOL_API_INTERNAL_URL=http://127.0.0.1:8082

# support-chat backend (OGC_ prefix)
SUPPORT_CHAT_CONFIG=apps/support-chat/configs/values.yml
