{
  "name": "@mos/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "icons:content": "node scripts/generate-content-icons.mjs",
    "icons:content:prompts": "node -e \"import('./scripts/content-icon-prompts.mjs').then(m=>console.log(Object.keys(m.questPrompts).length+' quests,',Object.keys(m.achievementPrompts).length+' achievements'))\"",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "test": "node --test src/lib/*.test.mjs",
    "chat:build": "npm --prefix ../../packages/support-chat-widget run build && mkdir -p public/chat && cp ../../packages/support-chat-widget/dist/og-chat.js public/chat/og-chat.js"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.3",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
}
