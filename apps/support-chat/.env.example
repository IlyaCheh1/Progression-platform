# Chat Service Environment Variables
# Use OGC_ prefix for environment variables

# ---
# Logger Configuration
# ---
# Log level - possible values: debug, info, warn, error
OGC_LOGGER_LEVEL=info

# ---
# Server Configuration  
# ---
# Internal server (health checks)
OGC_SERVER_INTERNAL_HOST=localhost
OGC_SERVER_INTERNAL_PORT=8080

# OpenAPI server (main API)
OGC_SERVER_OPENAPI_HOST=localhost
OGC_SERVER_OPENAPI_PORT=8081

# ---
# PostgreSQL Database Configuration
# ---
OGC_POSTGRESQL_USERNAME=chat
OGC_POSTGRESQL_PASSWORD=password
OGC_POSTGRESQL_DBHOST=localhost
OGC_POSTGRESQL_DBPORT=5432
OGC_POSTGRESQL_DBNAME=og-chat
